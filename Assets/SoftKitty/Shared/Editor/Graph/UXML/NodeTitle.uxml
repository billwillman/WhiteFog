        <engine:TextField max-length="12" name="RenameField" style="width: 143px; background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-904435991&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Rect&quot;); -unity-background-image-tint-color: rgb(2, 2, 2); margin-bottom: -2px; height: 25px; max-height: 25px; min-height: 25px; padding-bottom: -2px;">
            <engine:Button name="RenameConfirm" style="background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-1844788574&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Check&quot;); width: 20px; max-width: 20px; min-width: 20px; padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 2px; margin-right: 5px; height: 17px; max-height: 17px; min-height: 17px; margin-top: 4px; margin-bottom: 4px;" />
        </engine:TextField>
