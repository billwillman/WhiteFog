<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SoftKitty/Shared/Editor/Graph/Style/ToolBox.uss?fileID=7433441132597879392&amp;guid=464f79271082aed4a80398584deb24cc&amp;type=3#ToolBox" />
    <engine:VisualElement name="Root" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=72042407&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Bar&quot;); -unity-background-image-tint-color: rgb(43, 43, 43); top: -3px; justify-content: flex-start; align-content: flex-start; flex-direction: row-reverse; align-items: flex-start; align-self: flex-start;">
        <MyUILibrary.SlideToggle label="调试模式" tooltip="打开图调试视图。粘贴调试字符串后，在各节点上查看计算结果。" focusable="false" name="debugToggle" data-source-path="debug" style="height: 32px; width: 160px; -unity-text-align: middle-right; font-size: 13px; -unity-font-style: normal; text-shadow: 2px 6px 1px rgb(0, 0, 0); color: rgb(215, 215, 215); justify-content: flex-start; align-self: flex-end; bottom: 4px; margin-top: 2px; top: -3px; margin-right: 0;" />
        <MyUILibrary.SlideToggle label="自动保存" tooltip="开启或关闭自动保存。" focusable="false" name="AutoSaveToggle" data-source-path="autoSave" style="height: 32px; width: 160px; -unity-text-align: middle-right; font-size: 13px; -unity-font-style: normal; text-shadow: 2px 6px 1px rgb(0, 0, 0); color: rgb(215, 215, 215); justify-content: flex-start; align-self: flex-end; bottom: 4px; margin-top: 2px; top: -3px; margin-right: 0;" />
        <engine:ProgressBar value="100" name="Progress" enabled="true" style="width: 110px; margin-top: 6px; margin-bottom: 6px; -unity-background-image-tint-color: rgb(56, 56, 56); opacity: 0.76; font-size: 12px; scale: 1 0.9; margin-left: 11px;" />
        <engine:Button text="恢复" focusable="false" tooltip="恢复到打开该图时的内容。" double-click-selects-word="false" triple-click-selects-line="false" name="DiscardButton" icon-image="project://database/Assets/SoftKitty/Shared/Sprites/GraphInterface.png?fileID=1830347165&amp;guid=b3e7e8e38ace138489249ef690d4c143&amp;type=3#GraphInterface_2" style="width: 90px; height: 25px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=72042407&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Bar&quot;); background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(29, 160, 58); color: rgb(217, 217, 217); -unity-font-style: bold; text-shadow: 2px 5px 1px rgb(0, 0, 0); padding-bottom: 0; margin-top: 4px; align-content: center; justify-content: center; padding-top: 0; padding-left: 0; padding-right: 5px;" />
        <engine:Button text="保存" focusable="false" tooltip="保存当前图的改动。" double-click-selects-word="false" triple-click-selects-line="false" name="SaveButton" icon-image="project://database/Assets/SoftKitty/Shared/Sprites/GraphInterface.png?fileID=2018489480&amp;guid=b3e7e8e38ace138489249ef690d4c143&amp;type=3#GraphInterface_1" style="width: 90px; height: 25px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=72042407&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Bar&quot;); background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(29, 80, 160); color: rgb(217, 217, 217); -unity-font-style: bold; text-shadow: 2px 5px 1px rgb(0, 0, 0); padding-bottom: 0; margin-top: 4px; align-content: center; justify-content: center; padding-top: 0; padding-left: 0; padding-right: 5px;" />
    </engine:VisualElement>
</engine:UXML>
