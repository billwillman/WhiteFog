<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SoftKitty/Shared/Editor/Graph/Style/Node.uss?fileID=7433441132597879392&amp;guid=e09e757ca5a251142b749eebf4515fd2&amp;type=3#Node" />
    <engine:VisualElement name="Root" style="flex-grow: 1; -unity-background-image-tint-color: rgb(38, 38, 38); background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-904435991&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Rect&quot;); padding-top: 5px;">
        <engine:DropdownField label="类型" choices="AttributeChangeAction" index="0" name="Type" tooltip="动作类型。" style="width: 300px; left: 0; position: relative; align-self: flex-end; height: 30px;" />
        <engine:DropdownField label="执行方式" choices="Only Once" index="0" name="ExcuteType" data-source-type="SoftKitty.Action, Assembly-CSharp" data-source-path="Type" tooltip="此动作的执行方式。" style="width: 300px; left: 0; position: relative; align-self: flex-end; height: 30px;" />
        <engine:FloatField label="延迟（秒）" value="0" name="WaitTime" data-source-type="SoftKitty.Action, Assembly-CSharp" data-source-path="WaitTime" tooltip="动作开始前要等待的秒数。" max-length="4" style="height: 30px;" />
        <engine:IntegerField label="执行次数" value="1" name="Count" data-source-type="SoftKitty.Action, Assembly-CSharp" data-source-path="Count" tooltip="此动作的执行次数。" max-length="1" style="height: 30px;">
            <engine:VisualElement name="Adjust" style="flex-grow: 1; justify-content: center; height: 33px; width: 21px; align-self: center; align-items: center; align-content: center; max-width: 21px; min-width: 21px; max-height: 33px; min-height: 33px; background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-904435991&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Rect&quot;); -unity-background-image-tint-color: rgb(45, 45, 45);">
                <engine:Button name="AdjustUp" tooltip="加一" usage-hints="None" double-click-selects-word="false" triple-click-selects-line="false" style="background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-1219058343&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#ArrowV&quot;); background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); width: 13px; height: 13px; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0; align-self: flex-end; margin-bottom: 5px; rotate: 180deg; top: 2px; bottom: 0;" />
                <engine:Button name="AdjustDown" tooltip="减一" double-click-selects-word="false" triple-click-selects-line="false" style="background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-1219058343&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#ArrowV&quot;); background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); width: 13px; height: 13px; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0; align-self: flex-end; margin-bottom: 5px; bottom: 2px;" />
            </engine:VisualElement>
        </engine:IntegerField>
        <engine:FloatField label="持续（秒）" value="0" name="KeepTime" data-source-type="SoftKitty.Action, Assembly-CSharp" data-source-path="KeepTime" tooltip="持续时长大于 0 时，动作按间隔执行至时间耗尽。" max-length="4" style="height: 30px;" />
        <engine:FloatField label="间隔（秒）" value="0" name="IntervalTime" data-source-type="SoftKitty.Action, Assembly-CSharp" data-source-path="Interval" tooltip="相邻两次执行的时间间隔。" max-length="4" style="height: 30px;" />
    </engine:VisualElement>
</engine:UXML>
