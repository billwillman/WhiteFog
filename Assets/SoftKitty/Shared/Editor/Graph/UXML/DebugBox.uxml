<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SoftKitty/Shared/Editor/Graph/Style/ToolBox.uss?fileID=7433441132597879392&amp;guid=464f79271082aed4a80398584deb24cc&amp;type=3#ToolBox" />
    <engine:VisualElement name="Root" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-904435991&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Rect&quot;); -unity-background-image-tint-color: rgb(43, 43, 43); top: -3px; justify-content: flex-start; align-content: center; flex-direction: column-reverse; align-items: center; align-self: flex-start; margin-bottom: 0; padding-bottom: 11px;">
        <engine:Button text="调试" focusable="false" tooltip="在上方粘贴图调试字符串，即可逐个查看节点保存的计算结果。" double-click-selects-word="false" triple-click-selects-line="false" name="debugButton" icon-image="project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=2021875884&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Circle" style="width: 90px; height: 25px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=72042407&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Bar&quot;); background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(29, 160, 58); color: rgb(217, 217, 217); -unity-font-style: bold; text-shadow: 2px 5px 1px rgb(0, 0, 0); padding-bottom: 0; margin-top: 4px; align-content: center; justify-content: center; padding-top: 0; padding-left: 0; padding-right: 5px;" />
        <engine:TextField placeholder-text="粘贴图调试字符串以查看各节点计算结果。" name="debugText" multiline="true" vertical-scroller-visibility="Auto" style="height: 179px; width: 582px; background-image: none;" />
        <engine:Label text="启用调试模式后，图每次求值都会向控制台输出调试字符串。复制并粘贴到这里，即可查看各节点的结果。" style="height: 68px; width: 588px; color: rgb(186, 186, 186); margin-left: 20px;" />
    </engine:VisualElement>
</engine:UXML>
