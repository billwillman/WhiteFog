<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SoftKitty/Shared/Editor/Graph/Style/Node.uss?fileID=7433441132597879392&amp;guid=e09e757ca5a251142b749eebf4515fd2&amp;type=3#Node" />
    <engine:VisualElement name="Root" style="flex-grow: 1; -unity-background-image-tint-color: rgb(38, 38, 38); background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-904435991&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Rect&quot;); padding-top: 5px;">
        <engine:DropdownField label="类型" choices="Attribute" index="0" name="Type" tooltip="条件判定的类型。" style="width: 250px; left: 0; position: relative; align-self: flex-end; height: 30px;" />
        <engine:DropdownField label="更新方式" choices="Default" index="0" name="StateType" data-source-type="SoftKitty.Action, Assembly-CSharp" data-source-path="Type" tooltip="此条件的更新方式。" style="width: 250px; left: 0; position: relative; align-self: flex-end; height: 30px;" />
        <engine:IntegerField label="次数" value="2" name="Ticks" data-source-type="SoftKitty.Action, Assembly-CSharp" data-source-path="Count" tooltip="条件每满足指定次数，向触发器输出一次真。" max-length="2" style="height: 30px;">
            <engine:VisualElement name="Adjust" style="flex-grow: 1; justify-content: center; height: 33px; width: 21px; align-self: center; align-items: center; align-content: center; max-width: 21px; min-width: 21px; max-height: 33px; min-height: 33px; background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-904435991&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Rect&quot;); -unity-background-image-tint-color: rgb(45, 45, 45);">
                <engine:Button name="TickUp" tooltip="加一" usage-hints="None" double-click-selects-word="false" triple-click-selects-line="false" style="background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-1219058343&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#ArrowV&quot;); background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); width: 13px; height: 13px; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0; align-self: flex-end; margin-bottom: 5px; rotate: 180deg; top: 2px; bottom: 0;" />
                <engine:Button name="TickDown" tooltip="减一" double-click-selects-word="false" triple-click-selects-line="false" style="background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-1219058343&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#ArrowV&quot;); background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); width: 13px; height: 13px; padding-bottom: 0; padding-top: 0; padding-right: 0; padding-left: 0; align-self: flex-end; margin-bottom: 5px; bottom: 2px;" />
            </engine:VisualElement>
        </engine:IntegerField>
        <engine:VisualElement style="flex-grow: 1; height: 65px; max-height: 65px; min-height: 65px; background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-904435991&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Rect&quot;); -unity-background-image-tint-color: rgb(13, 13, 13); margin-left: 10px; margin-right: 10px;">
            <engine:Label text="条件满足时，向触发器持续输出真 1 帧。" name="StateHint" style="color: rgb(114, 114, 114); white-space: pre-wrap; padding-left: 8px; padding-right: 8px; align-self: stretch; -unity-text-align: middle-left; width: auto; bottom: 0; position: absolute; top: 0; right: 0; left: 0; margin-top: 0; padding-top: 2px;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
