<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/SoftKitty/Shared/Editor/Graph/Style/Node.uss?fileID=7433441132597879392&amp;guid=e09e757ca5a251142b749eebf4515fd2&amp;type=3#Node" />
    <engine:VisualElement name="Root" style="flex-grow: 1; -unity-background-image-tint-color: rgb(38, 38, 38); background-image: url(&quot;project://database/Assets/SoftKitty/Shared/Sprites/Shared_ui.png?fileID=-904435991&amp;guid=cec9663a2fad9b64abe1c9eb3d3def57&amp;type=3#Rect&quot;); padding-top: 5px;">
        <engine:DropdownField label="类型" choices="Constant" index="0" name="Type" data-source-type="SoftKitty.Action, Assembly-CSharp" data-source-path="Type" tooltip="变量类型。" style="width: 300px; left: 0; position: relative; align-self: flex-end; height: 30px;" />
        <engine:DropdownField label="属性" choices="Attack" index="0" name="Attribute" tooltip="属性类型。" style="width: 300px; left: 0; position: relative; align-self: flex-end; height: 30px;" />
        <engine:TextField label="UID" placeholder-text="请输入 UID" name="Uid" tooltip="变量的字符串 UID，代码可通过该 UID 设置变量值。" max-length="10" />
        <engine:FloatField label="数值" value="0" name="Value" data-source-type="SoftKitty.Action, Assembly-CSharp" data-source-path="WaitTime" tooltip="此变量的数值。" max-length="8" style="height: 30px;" />
        <engine:FloatField label="最小值" value="0" name="Min" data-source-type="SoftKitty.Action, Assembly-CSharp" data-source-path="WaitTime" tooltip="此变量的数值。" max-length="8" style="height: 30px;" />
        <engine:FloatField label="最大值" value="0" name="Max" data-source-type="SoftKitty.Action, Assembly-CSharp" data-source-path="WaitTime" tooltip="此变量的数值。" max-length="8" style="height: 30px;" />
    </engine:VisualElement>
</engine:UXML>
